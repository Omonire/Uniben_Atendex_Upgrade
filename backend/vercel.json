{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "frontend/templates/**",
          "frontend/static/**"
        ]
      }
    },
    {
      "src": "frontend/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/_vercel/insights/(.*)",
      "dest": "backend/index.py"
    },
    {
      "src": "/_vercel/speed-insights/(.*)",
      "dest": "backend/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/index.py"
    }
  ]
}
